generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OtpChallenge {
  id         String    @id @default(uuid())
  phone      String
  role       String    // PASSENGER | DRIVER | ADMIN
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("otp_challenge")
}

model AppSession {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("app_session")
}

model AppUser {
  id         String   @id @default(uuid())
  phone      String   @unique
  role       String   @default("PASSENGER") // PASSENGER | DRIVER | ADMIN
  name       String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  sessions      AppSession[]
  driverProfile DriverProfile?
  transactions  Transaction[]

  @@map("app_user")
}

model DriverProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  displayName           String
  nationalIdUrl         String?   @db.Text
  licenseUrl            String?   @db.Text
  vehicleMake           String?
  vehicleModel          String?
  vehicleColor          String?
  plateNumber           String
  profilePhotoUrl       String?   @db.Text
  verificationStatus    String    @default("PENDING") // PENDING | APPROVED | REJECTED
  addispaySubMerchantId String?
  payoutAccountRef      String?
  rating                Decimal   @default(5.00) @db.Decimal(3, 2)
  createdAt             DateTime  @default(now())

  user         AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  qrs          TaxiQr[]
  transactions Transaction[]

  @@map("driver_profile")
}

model TaxiQr {
  id              String    @id @default(uuid())
  taxiId          String    @unique
  driverProfileId String
  status          String    @default("ACTIVE") // ACTIVE | DISABLED | REPLACED
  qrPayloadUrl    String
  backupCode      String?
  createdAt       DateTime  @default(now())
  disabledAt      DateTime?
  disabledReason  String?

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  transactions  Transaction[]

  @@map("taxi_qr")
}

model Transaction {
  id                     String    @id @default(uuid())
  taxiQrId               String
  driverProfileId        String
  passengerUserId        String?
  amount                 Decimal   @db.Decimal(12, 2)
  currency               String    @default("ETB")
  status                 String    @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED | UNKNOWN
  addispayTransactionRef String?   @unique
  addispayRawPayload     String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
  confirmedAt            DateTime?

  qr            TaxiQr        @relation(fields: [taxiQrId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  passengerUser AppUser?      @relation(fields: [passengerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([driverProfileId])
  @@index([taxiQrId])
  @@index([status])
  @@index([createdAt])
  @@map("transaction")
}

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String   @default("ADDISPAY")
  providerEventId String
  eventType       String?
  transactionId   String?
  rawPayload      String?  @db.Text
  processed       Boolean  @default(false)
  receivedAt      DateTime @default(now())

  @@unique([provider, providerEventId])
  @@map("webhook_event")
}
