# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication — use a long random string in production
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Database Configuration (used by Prisma ORM)
# SQL Server (local):
DATABASE_URL="sqlserver://localhost:1433;database=paytaxi;user=sa;password=<PASSWORD>;trustServerCertificate=true;"
# For Supabase/PostgreSQL (cloud), switch provider in schema.prisma to "postgresql":
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# AddisPay Integration (Simulated for now)
ADDISPAY_API_KEY=
ADDISPAY_MERCHANT_ID=
ADDISPAY_BASE_URL=https://uat.api.addispay.et
ADDISPAY_WEBHOOK_SECRET=

# Frontend URLs for CORS
FRONTEND_URL=http://localhost:3000